# Caddy configuration for the shared VPS.
# Each app's site block lives in apps/<name>.caddy, created by scripts/register-app.sh
# (or the "Register app" workflow). Don't add app blocks here.
{
	# Admin API for `caddy reload` and the healthcheck. Both run inside this
	# container, so it only needs to listen on localhost, not on caddy-web
	# where every app backend could reach it.
	admin localhost:2019

	# Email for Let's Encrypt notifications
	email wayne.zhu6@gmail.com
}

import apps/*.caddy

# Default response for unmatched domains
:80 {
	respond "No site configured for this domain" 404
}
