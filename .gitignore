# Environment files
.env

# Per-app database credentials, generated on the server
secrets/

# Don't commit built frontend files (deploy separately)
sites/*/
!sites/.gitkeep

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Deploy logs and state, written by the deployer on the server
deploys/

# Backups, written by the backup container on the server
backups/

# Caddy access logs, read by the monitor
logs/
