# Registered by scripts/register-app.sh --static. App: __NAME__ (static files, no backend)
# Imported inside the waynezhu.dev site block in the Caddyfile.
#   waynezhu.dev/apps/__NAME__/...  -> the files in /srv/__NAME__
# The app's infra.yml has backend: false, so the deployer only publishes the
# files in its image's /app/frontend/dist and starts no container.

redir /apps/__NAME__ /apps/__NAME__/ 308

handle_path /apps/__NAME__/* {
	root * /srv/__NAME__

	# Until the app's first deploy publishes its files, say so rather than
	# serve a blank 404, so a new registration can be checked on its own.
	@undeployed not file {
		root /srv/__NAME__
		try_files /
	}
	handle @undeployed {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>__NAME__</title>
			<style>body{margin:0;min-height:100vh;display:grid;place-items:center;text-align:center;font:17px/1.5 system-ui,sans-serif;color:#555;background:#fbf9f4}@media(prefers-color-scheme:dark){body{color:#aaa;background:#1c1b19}}b{color:inherit;font-size:1.3em}</style></head>
			<body><p><b>__NAME__</b><br>Registered, but nothing has been deployed here yet.</p></body>
			</html>
			HTML 503
	}
	encode gzip zstd
	header Cache-Control "no-cache"
	file_server
}
