# Registered by scripts/register-app.sh. App: txtify
# Imported inside the waynezhu.dev site block in the Caddyfile.
#   waynezhu.dev/apps/txtify/...  -> the frontend in /srv/txtify
#   waynezhu.dev/api/txtify/...   -> txtify-backend:3001 as /api/...

redir /apps/txtify /apps/txtify/ 308

handle_path /api/txtify/* {
	rewrite * /api{path}
	reverse_proxy txtify-backend:3001 {
		header_up X-Real-IP {remote_host}
	}
}

handle_path /apps/txtify/* {
	root * /srv/txtify

	# Until the app's first deploy publishes a frontend, say so rather than
	# serve a blank 404, so a new registration can be checked on its own.
	@undeployed not file {
		root /srv/txtify
		try_files /index.html
	}
	handle @undeployed {
		header Content-Type "text/html; charset=utf-8"
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>txtify</title>
			<style>body{margin:0;min-height:100vh;display:grid;place-items:center;text-align:center;font:17px/1.5 system-ui,sans-serif;color:#555;background:#fbf9f4}@media(prefers-color-scheme:dark){body{color:#aaa;background:#1c1b19}}b{color:inherit;font-size:1.3em}</style></head>
			<body><p><b>txtify</b><br>Registered, but nothing has been deployed here yet.</p></body>
			</html>
			HTML 503
	}
	encode gzip zstd
	# Unknown paths fall back to index.html so client-side routes work.
	try_files {path} /index.html
	file_server

	# Built assets have hashed names, so they can be cached forever; anything
	# else (index.html and files in public/) must be re-checked.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@other not path /assets/*
	header @other Cache-Control "no-cache"
}
