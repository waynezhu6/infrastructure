# Registered by scripts/register-app.sh. App: txtify
# Imported inside the waynezhu.dev site block in the Caddyfile.
#   waynezhu.dev/apps/txtify/...  -> the frontend in /srv/txtify
#   waynezhu.dev/api/txtify/...   -> txtify-backend:3001 as /api/...

redir /apps/txtify /apps/txtify/ 308

handle_path /api/txtify/* {
	rewrite * /api{path}
	reverse_proxy txtify-backend:3001 {
		header_up X-Real-IP {remote_host}
	}
}

handle_path /apps/txtify/* {
	root * /srv/txtify
	encode gzip zstd
	# Unknown paths fall back to index.html so client-side routes work.
	try_files {path} /index.html
	file_server

	# Built assets have hashed names, so they can be cached forever; anything
	# else (index.html and files in public/) must be re-checked.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@other not path /assets/*
	header @other Cache-Control "no-cache"
}
